# Copy this file to .env and adjust as needed.

DEBUG=false
ALLOWED_ORIGINS=["*"]

# Path to the fine-tuned DistilBERT checkpoint folder
DISTILBERT_MODEL_PATH=saved_models/distilbert_sentiment
MAX_SEQUENCE_LENGTH=96

# Hugging Face Inference Providers
# Get a free token (read scope) at https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=******************************

# Dedicated sentiment classifier — fast, reliable label + confidence
HF_MODEL_REPO_ID=cardiffnlp/twitter-roberta-base-sentiment-latest
HF_PROVIDER=hf-inference

# Small chat model — used ONLY to explain the already-decided label
#HF_REASON_MODEL_REPO_ID=Qwen/Qwen2.5-1.5B-Instruct
#HF_REASON_PROVIDER=auto
HF_REASON_MODEL_REPO_ID=openai/gpt-oss-20b
HF_REASON_PROVIDER=groq
LLM_TEMPERATURE=0.3
LLM_MAX_NEW_TOKENS=200
LLM_TIMEOUT_SECONDS=35

MAX_TEXT_LENGTH=3000
